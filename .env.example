# ---------------------------------------------------------------------------
# Database. PostgreSQL with pgvector, pg_trgm and pgcrypto.
# Neon gives you two strings: the -pooler one for the app, the plain one for
# migrations. Both are needed.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/medcity_lms?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/medcity_lms?sslmode=require"

# ---------------------------------------------------------------------------
# Hosting. APP_BASE_DOMAIN is the parent domain, not the subdomain: tenant
# subdomains are resolved as <slug>.<APP_BASE_DOMAIN>, and any other hostname
# is matched against the TenantDomain table.
# APP_HOSTNAME is read by the seed so the hostname you serve on gets a row.
# ---------------------------------------------------------------------------
APP_BASE_DOMAIN="medcitylms.in"
APP_HOSTNAME="demo.medcitylms.in"
PLATFORM_HOST="platform.medcitylms.in"
NODE_ENV="production"

# 32+ random characters. Rotating it signs everyone out.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Seed only. Read once by `npm run db:seed` to create the first Super Admin.
# Remove them from the server environment afterwards.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@medcitylms.in"
SEED_ADMIN_NAME="Medcity Admin"
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Object storage for materials and recordings. S3 compatible: R2, S3, Wasabi.
# Not needed until file uploads land in Phase 1.
# ---------------------------------------------------------------------------
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_BASE_URL=""

# Payments. Phase 3.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Live classes. Phase 2.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Messaging. Phase 6.
SMTP_URL=""
MSG91_AUTH_KEY=""
AISENSY_API_KEY=""

# AI layer. Phase 7.
ANTHROPIC_API_KEY=""
